{
  "name": "pineapplegallery",
  "type": "module",
  "scripts": {
    "base:static": "npm run movedot && cpx \"public/**/*\" dist",
    "base:esbuild": "esbuild --bundle src/index.jsx --format=esm --outfile=dist/_worker.js",
    "dev": "run-p dev:*",
    "dev:esbuild": "npm run base:esbuild -- --watch",
    "dev:static": "npm run base:static -- --watch",
    "dev:minify": "npm run build:minify",
    "dev:wrangler": "wrangler dev --live-reload",
    "cibuild": "npm run generate-types && npm run build",
    "build": "npm run clean && run-p build:*",
    "clean": "rimraf dist",
    "build:esbuild": "npm run base:esbuild",
    "build:static": "npm run base:static",
    "build:minify": "npm run minify:js && npm run minify:css",
    "minify:js": "npx foreach -g \"./dist/static/js/**.js\" -x \"node-minify --compressor uglify-js --input #{path} --output #{path}\"",
    "minify:css": "npx foreach -g \"./dist/static/css/**.css\" -x \"node-minify --compressor cssnano --input #{path} --output #{path}\"",
    "movedot": "cpx \"public/.assetsignore\" dist",
    "deploy": "wrangler deploy",
    "generate-types": "wrangler types",
    "types": "wrangler types"
  },
  "dependencies": {
    "accept-language-parser": "^1.5.0",
    "hono": "^4.13.17",
    "just-clamp": "^4.2.0",
    "just-has": "^2.3.0",
    "just-is-empty": "^3.4.1",
    "just-truncate": "^2.2.0",
    "mime": "^4.1.2",
    "rimraf": "^6.1.3",
    "shuffle-array": "^1.0.1"
  },
  "devDependencies": {
    "@node-minify/cli": "^10.5.0",
    "@node-minify/cssnano": "^10.5.0",
    "@node-minify/uglify-js": "^10.5.0",
    "@types/node": "^24.19.2",
    "cpx2": "^9.0.3",
    "foreach-cli": "^1.8.1",
    "npm-run-all2": "^9.0.2",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "cpx2": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.3"
    },
    "@node-minify/cssnano": {
      "postcss": "^8.5.18"
    },
    "@actions/github": {
      "undici": "^7.30.1"
    },
    "@actions/http-client": {
      "undici": "^7.30.1"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
